# ---- Contact form email (Nodemailer) ----
# Gmail example: host smtp.gmail.com, port 465 (or 587), user = your Gmail,
# pass = a Google "App password" (not your normal password)
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=465
NODEMAILER_USER=
NODEMAILER_PASS=
USER_MAILER=
USER_TO=dc7090210@gmail.com

# ---- View / love counters (MongoDB Atlas free tier) ----
MONGODB_URI=

# ---- Optional: spam protection (Cloudflare Turnstile) ----
# Leave both empty to disable the captcha.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ---- Optional: Google Analytics ----
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
